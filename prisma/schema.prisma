generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TaMatch {
  numMatch   Int       @id @map("NUM_MATCH")
  matchCase  Int       @map("MATCH_CASE")
  equipe1    String    @map("EQUIPE1")
  equipe2    String    @map("EQUIPE2")
  equipeId1  Int?      @map("EQUIPE_ID1")
  equipeId2  Int?      @map("EQUIPE_ID2")
  score1     Int?      @map("SCORE1")
  score2     Int?      @map("SCORE2")
  etat       String    @map("ETAT")
  dateHeure  DateTime  @map("DATEHEURE")
  surfacage  Int       @map("SURFACAGE")
  ecart      String    @map("ECART")
  lienPhotos String?   @map("LIEN_PHOTOS")
  nbPhotos   Int       @map("NB_PHOTOS")
  ancienLien String?   @map("ANCIEN_LIEN")

  @@map("TA_MATCHS")
}

model TaEquipe {
  id               Int       @id @map("ID")
  equipe           String    @map("EQUIPE")
  teaser           String?   @map("TEASER") @db.Text
  image            String?   @map("IMAGE")
  couleurFont      String    @map("COULEUR_FONT")
  couleurBack      String    @map("COULEUR_BACK")
  coach1           String?   @map("COACH_1")
  coach2           String?   @map("COACH_2")
  coach3           String?   @map("COACH_3")
  coach4           String?   @map("COACH_4")
  equipeRefId      Int?      @map("EQUIPE_REF_ID")
  equipeRef        InscEquipeReferentiel? @relation(fields: [equipeRefId], references: [id])

  @@map("ta_equipes")
}

model TaClassement {
  groupeNom       String    @map("GROUPE_NOM")
  ordre           Int       @map("ORDRE")
  ordreFinal      Int       @map("ORDRE_FINAL")
  equipe          String    @map("EQUIPE")
  equipeId        Int       @map("EQUIPE_ID")
  joues           Int       @map("J")
  victoires       Int       @map("V")
  nuls            Int       @map("N")
  defaites        Int       @map("D")
  points          Int       @map("PTS")
  bp              Int       @map("BP")
  bc              Int       @map("BC")
  diff            Int       @map("DIFF")
  repasSamedi     DateTime? @map("REPAS_SAMEDI")
  repasDimanche   DateTime? @map("REPAS_DIMANCHE")
  repasLundi      DateTime? @map("REPAS_LUNDI")
  challengeSamedi DateTime? @map("CHALLENGE_SAMEDI")

  @@id([groupeNom, ordre])
  @@map("ta_classement")
}

model TaJoueur {
  id                 Int      @id @map("ID")
  equipeId           Int      @map("EQUIPE_ID")
  numero             Int      @map("NUMERO")
  position           String   @map("POSITION")
  nom                String   @map("NOM")
  prenom             String   @map("PRENOM")
  tempsSlalom        String   @map("TEMPS_SLALOM")
  timeSlalom         Int      @map("TIME_SLALOM")
  nbPortes           Int      @map("NB_PORTES")
  tempsVitesse       String   @map("TEMPS_VITESSE")
  timeVitesse        Int      @map("TIME_VITESSE")
  tir1               Int?     @map("TIR1")
  tir2               Int?     @map("TIR2")
  tir3               Int?     @map("TIR3")
  tempsTotal         String   @map("TEMPS_TOTAL")
  timeTotal          Int?     @map("TIME_TOTAL")
  qf                 String?  @map("QF")
  df                 String?  @map("DF")
  f                  String?  @map("F")
  v                  String?  @map("V")
  gardienNbBut       Int?     @map("GARDIEN_NB_BUT")
  gardienTempsAtelier String  @map("GARDIEN_TEMPS_ATELIER")
  gardienTimeAtelier  Int     @map("GARDIEN_TIME_ATELIER")
  gardienTempsVitesse String  @map("GARDIEN_TEMPS_VITESSE")
  gardienTimeVitesse  Int     @map("GARDIEN_TIME_VITESSE")
  gardienTempsTotal   String  @map("GARDIEN_TEMPS_TOTAL")
  gardienTimeTotal    Int     @map("GARDIEN_TIME_TOTAL")
  gardienDf          String?  @map("GARDIEN_DF")
  gardienF           String?  @map("GARDIEN_F")
  gardienV           String?  @map("GARDIEN_V")

  @@map("ta_joueurs")
}

model TaConfiguration {
  id                 Int      @id @map("id")
  nbAvant            Int      @map("nb_avant")
  nbSamedi           Int      @map("nb_samedi")
  nbDimanche         Int      @map("nb_dimanche")
  nbApres            Int      @map("nb_apres")
  tirDehors          Int      @map("tir_dehors")
  tirDedans          Int      @map("tir_dedans")
  tirHaut            Int      @map("tir_haut")
  tirBas             Int      @map("tir_bas")
  libelleDehors      String?  @map("libelle_dehors")
  libelleDedant      String?  @map("libelle_dedant")
  libelleBasse       String?  @map("libelle_basse")
  libelleHaute       String?  @map("libelle_haute")
  penalitePorte      Int      @map("penalite_porte")
  libellePorte       String?  @map("libelle_porte")
  libelleArretSeconde String? @map("libelle_arret_seconde")
  arretSeconde       Int      @map("arret_seconde")

  @@map("ta_configuration")
}

// ===== MODULE INSCRIPTIONS =====

enum InscriptionStatut {
  CANDIDATE
  RESERVEE
  LISTE_ATTENTE
  PAIEMENT_ATTENDU
  VALIDEE
  DOSSIER_EN_COURS
  DOSSIER_COMPLET
  REFUSEE

  @@map("insc_inscription_statut")
}

enum UtilisateurRole {
  RESPONSABLE_EQUIPE
  ORGANISATEUR
  TABLE_DE_MARQUE

  @@map("insc_utilisateur_role")
}

model InscUtilisateur {
  id          Int      @id @default(autoincrement())
  providerUid String   @unique @map("provider_uid") @db.VarChar(128)
  provider    String   @default("google") @map("provider") @db.VarChar(20)
  email       String   @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(255)
  pseudo      String?  @db.VarChar(50)
  role        UtilisateurRole @default(RESPONSABLE_EQUIPE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  inscriptions InscInscription[]

  @@map("insc_utilisateurs")
}

model InscEdition {
  id                      Int      @id @default(autoincrement())
  nom                     String   @db.VarChar(100)
  categorie               String   @db.VarChar(20)
  annee                   Int
  etape                   String   @default("CREEE") @db.VarChar(30)
  dateDebut               DateTime @map("date_debut")
  dateFinDebut            DateTime @map("date_fin_debut")
  dateFinFin              DateTime @map("date_fin_fin")
  fraisInscription        Decimal  @map("frais_inscription") @db.Decimal(8,2)
  prixRepas               Decimal  @map("prix_repas") @db.Decimal(8,2)
  nbPlacesMax             Int      @default(16) @map("nb_places_max")
  imageUrl                String?  @map("image_url") @db.VarChar(500)
  imageDossierUrl         String?  @map("image_dossier_url") @db.VarChar(500)
  imageRibUrl             String?  @map("image_rib_url") @db.VarChar(500)
  contactEmail            String?  @map("contact_email") @db.VarChar(255)
  contactPhone            String?  @map("contact_phone") @db.VarChar(30)
  dureeSurfacageMin       Int      @default(20) @map("duree_surfacage_min")
  dureeMatchPouleMin      Int      @default(27) @map("duree_match_poule_min")
  dureeMatchFinalMin      Int      @default(33) @map("duree_match_final_min")
  affichagePlanningPublic Boolean  @default(false) @map("affichage_planning_public")
  msgBienvenue            String?  @map("msg_bienvenue") @db.Text
  msgFaisonsConnaissance  String?  @map("msg_faisons_connaissance") @db.Text
  msgSelectionEquipe      String?  @map("msg_selection_equipe") @db.Text
  msgAjoutEquipe          String?  @map("msg_ajout_equipe") @db.Text
  msgInscriptionEnCours   String?  @map("msg_inscription_en_cours") @db.Text
  msgInscriptionValidee   String?  @map("msg_inscription_validee_autre") @db.Text
  msgLancerDemande        String?  @map("msg_lancer_demande") @db.Text
  msgDemandeSoumise       String?  @map("msg_demande_soumise") @db.Text
  msgEquipeRefusee        String?  @map("msg_equipe_refusee") @db.Text
  msgListeAttente         String?  @map("msg_liste_attente") @db.Text
  msgPaiementAttendu      String?  @map("msg_paiement_attendu") @db.Text
  msgChequeInfo1          String?  @map("msg_cheque_info_1") @db.Text
  msgChequeInfo2          String?  @map("msg_cheque_info_2") @db.Text
  msgInscriptionConfirmee String?  @map("msg_inscription_confirmee") @db.Text
  msgRenseigneJoueurs     String?  @map("msg_renseigne_joueurs") @db.Text
  dureeInterMatchMin          Int?     @map("duree_inter_match_min")
  delaiMinActivite            Json?    @map("delai_min_activite")
  nbPatinoires                Int?     @map("nb_patinoires")
  nbPoules                    Int?     @map("nb_poules")
  nbEquipesParPoule           Int?     @map("nb_equipes_par_poule")
  nbEquipesQualifieesParPoule Int?     @map("nb_equipes_qualifiees_par_poule")
  formatPhaseFinale           PlanningFormatPhaseFinale? @map("format_phase_finale")
  reglesTieBreak              Json?    @map("regles_tie_break")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  inscriptions            InscInscription[]
  joursCompetition        InscEditionJour[]
  activitesCatalogue      ActiviteCatalogue[]
  creneauxActivite        CreneauActivite[]
  planningConfirmations   PlanningConfirmation[]
  planningMatchSlots      PlanningMatchSlot[]
  formatPhases            FormatPhase[]
  formatMeta              FormatMeta?
  anneesAge               InscEditionAnneeAge[]

  @@map("insc_editions")
}

model InscEditionAnneeAge {
  id        Int      @id @default(autoincrement())
  editionId Int      @map("edition_id")
  annee     Int
  createdAt DateTime @default(now()) @map("created_at")
  edition   InscEdition @relation(fields: [editionId], references: [id])

  @@unique([editionId, annee])
  @@map("insc_edition_annees_age")
}

model InscEquipeReferentiel {
  id         Int      @id @default(autoincrement())
  nom        String   @unique @db.VarChar(100)
  logoUrl    String?  @map("logo_url") @db.VarChar(500)
  active     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  inscriptions InscInscription[]
  taEquipes    TaEquipe[]

  @@map("insc_equipes_referentiel")
}

model InscInscription {
  id              Int      @id @default(autoincrement())
  editionId       Int      @map("edition_id")
  utilisateurId   Int      @map("utilisateur_id")
  equipeRefId     Int?     @map("equipe_ref_id")
  equipeNom       String   @map("equipe_nom") @db.VarChar(100)
  statut          InscriptionStatut @default(CANDIDATE)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  edition         InscEdition @relation(fields: [editionId], references: [id])
  utilisateur     InscUtilisateur @relation(fields: [utilisateurId], references: [id])
  equipeRef       InscEquipeReferentiel? @relation(fields: [equipeRefId], references: [id])
  dossier         InscDossier?

  @@unique([editionId, equipeRefId])
  @@map("insc_inscriptions")
}

model InscDossier {
  id                        Int      @id @default(autoincrement())
  inscriptionId             Int      @unique @map("inscription_id")
  dateVirementInscription   DateTime? @map("date_virement_inscription")
  dateReceptionInscription  DateTime? @map("date_reception_inscription")
  datePaiementRepas         DateTime? @map("date_paiement_repas")
  dateReceptionRepas        DateTime? @map("date_reception_repas")
  repasPaiementRecu         Boolean  @default(false) @map("repas_paiement_recu")
  droitsImageAcceptes       Boolean  @default(false) @map("droits_image_acceptes")
  droitsImageHorodatage     DateTime? @map("droits_image_horodatage")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  inscription               InscInscription @relation(fields: [inscriptionId], references: [id])
  joueurs                   InscJoueurDossier[]
  coachs                    InscCoachDossier[]

  @@map("insc_dossiers")
}

model InscJoueurDossier {
  id                    Int      @id @default(autoincrement())
  dossierId             Int      @map("dossier_id")
  nom                   String   @db.VarChar(100)
  prenom                String   @db.VarChar(100)
  numero                Int
  poste                 String   @db.VarChar(10)
  licenceFFH            String?  @map("licence_ffh") @db.VarChar(50)
  anneeNaissance        Int?     @map("annee_naissance")
  particularitesAlim    String?  @map("particularites_alim") @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  dossier               InscDossier @relation(fields: [dossierId], references: [id])
  matchButsButeur       MatchBut[]  @relation("MatchButButeur")
  matchButsAssist1      MatchBut[]  @relation("MatchButAssist1")
  matchButsAssist2      MatchBut[]  @relation("MatchButAssist2")
  matchPenalites        MatchPenalite[]

  @@map("insc_joueurs_dossier")
}

model InscCoachDossier {
  id              Int      @id @default(autoincrement())
  dossierId       Int      @map("dossier_id")
  nom             String   @db.VarChar(100)
  prenom          String   @db.VarChar(100)
  presenceRepas   Boolean  @default(false) @map("presence_repas")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  dossier         InscDossier @relation(fields: [dossierId], references: [id])

  @@map("insc_coachs_dossier")
}

model TaCacheSnapshot {
  id          Int      @id @default(autoincrement())
  snapshotKey String   @unique @map("snapshot_key") @db.VarChar(64)
  data        String   @db.LongText
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ta_cache_snapshots")
}

// ===== MODULE TABLE DE MARQUE =====

enum MatchLiveEtat {
  PLANIFIE
  ANNONCE
  EN_COURS
  EN_PAUSE
  TERMINE

  @@map("match_live_etat")
}

model MatchLive {
  numMatch            Int             @id @map("num_match")
  etat                MatchLiveEtat   @default(PLANIFIE)
  tempsEcouleSecondes Int             @default(0) @map("temps_ecoule_secondes")
  chronoEnCours       Boolean         @default(false) @map("chrono_en_cours")
  chronoDerniereMajAt DateTime?       @map("chrono_derniere_maj_at")
  score1Cache         Int             @default(0) @map("score1_cache")
  score2Cache         Int             @default(0) @map("score2_cache")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  buts                MatchBut[]
  penalites           MatchPenalite[]

  @@map("match_live")
}

model MatchBut {
  id               Int       @id @default(autoincrement())
  numMatch         Int       @map("num_match")
  equipeId         Int       @map("equipe_id")
  buteurId         Int       @map("buteur_id")
  assist1Id        Int?      @map("assist1_id")
  assist2Id        Int?      @map("assist2_id")
  tempsJeuSecondes Int       @map("temps_jeu_secondes")
  createdAt        DateTime  @default(now()) @map("created_at")
  matchLive        MatchLive @relation(fields: [numMatch], references: [numMatch])
  buteur           InscJoueurDossier  @relation("MatchButButeur", fields: [buteurId], references: [id])
  assist1          InscJoueurDossier? @relation("MatchButAssist1", fields: [assist1Id], references: [id])
  assist2          InscJoueurDossier? @relation("MatchButAssist2", fields: [assist2Id], references: [id])

  @@map("match_buts")
}

model MatchPenalite {
  id               Int       @id @default(autoincrement())
  numMatch         Int       @map("num_match")
  equipeId         Int       @map("equipe_id")
  joueurId         Int       @map("joueur_id")
  typePenaliteCode String    @map("type_penalite_code") @db.VarChar(30)
  dureeMinutes     Int       @map("duree_minutes")
  tempsJeuDebut    Int       @map("temps_jeu_debut")
  createdAt        DateTime  @default(now()) @map("created_at")
  matchLive        MatchLive @relation(fields: [numMatch], references: [numMatch])
  joueur           InscJoueurDossier @relation(fields: [joueurId], references: [id])
  typePenalite     MatchTypePenalite @relation(fields: [typePenaliteCode], references: [code])

  @@map("match_penalites")
}

model MatchTypePenalite {
  code               String  @id @db.VarChar(30)
  libelle            String  @db.VarChar(100)
  dureeMinutesDefaut Int     @map("duree_minutes_defaut")
  actif              Boolean @default(true)
  penalites          MatchPenalite[]

  @@map("match_types_penalite")
}

// ===== MODULE PLANNING =====

enum PlanningFormatPhaseFinale {
  ELIMINATION_DIRECTE
  POULES_FINALES
  CLASSEMENT_CROISE

  @@map("planning_format_phase_finale")
}

model InscEditionJour {
  id          Int      @id @default(autoincrement())
  editionId   Int      @map("edition_id")
  numeroJour  Int      @map("numero_jour")
  date        DateTime @map("date") @db.Date
  heureDebut  DateTime @map("heure_debut")
  heureFin    DateTime @map("heure_fin")
  typeJournee String   @map("type_journee") @db.VarChar(10)
  edition           InscEdition       @relation(fields: [editionId], references: [id])
  formatPhaseJours  FormatPhaseJour[]

  @@unique([editionId, numeroJour])
  @@map("insc_edition_jours")
}

enum CreneauActiviteStatut {
  LIBRE
  CONFIRME

  @@map("creneau_activite_statut")
}

model ActiviteCatalogue {
  id                 Int      @id @default(autoincrement())
  editionId          Int      @map("edition_id")
  label              String   @db.VarChar(100)
  dureeParEquipeMin  Int      @map("duree_par_equipe_min")
  capaciteParallele  Int      @default(1) @map("capacite_parallele")
  createdAt          DateTime @default(now()) @map("created_at")
  edition            InscEdition       @relation(fields: [editionId], references: [id])
  creneaux           CreneauActivite[]

  @@map("planning_activites_catalogue")
}

model CreneauActivite {
  id          Int      @id @default(autoincrement())
  editionId   Int      @map("edition_id")
  activiteId  Int      @map("activite_id")
  date        DateTime @map("date") @db.Date
  heureDebut  DateTime @map("heure_debut")
  dureeMin    Int      @map("duree_min")
  equipeId    Int?     @map("equipe_id")
  equipeLabel String?  @map("equipe_label") @db.VarChar(100)
  statut      CreneauActiviteStatut @default(LIBRE)
  createdAt   DateTime @default(now()) @map("created_at")
  edition     InscEdition       @relation(fields: [editionId], references: [id])
  activite    ActiviteCatalogue @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@map("planning_creneaux_activite")
}

model PlanningConfirmation {
  id                     Int      @id @default(autoincrement())
  editionId              Int      @map("edition_id")
  confirmedAt            DateTime @default(now()) @map("confirmed_at")
  nbMatchsCrees          Int      @map("nb_matchs_crees")
  nbActivitesCrees       Int      @map("nb_activites_crees")
  forcageEquipesFictives Boolean  @default(false) @map("forcage_equipes_fictives")
  edition                InscEdition @relation(fields: [editionId], references: [id])

  @@map("planning_confirmations")
}

enum PlanningSlotRole {
  VAINQUEUR
  PERDANT

  @@map("planning_slot_role")
}

// Résolution automatique des placeholders de planning (J2/J3) une fois les
// classements/résultats de brassage ou de bracket connus en direct.
model PlanningMatchSlot {
  id                 Int               @id @default(autoincrement())
  editionId          Int               @map("edition_id")
  numMatch           Int               @map("num_match")
  cote               Int               @map("cote")
  ref                String            @map("ref") @db.VarChar(80)
  libellePlaceholder String            @map("libelle_placeholder") @db.VarChar(100)
  numMatchSource     Int?              @map("num_match_source")
  pouleCode          String?           @map("poule_code") @db.VarChar(4)
  rangPoule          Int?              @map("rang_poule")
  role               PlanningSlotRole  @default(VAINQUEUR) @map("role")
  resolu             Boolean           @default(false)
  equipeIdResolu     Int?              @map("equipe_id_resolu")
  equipeNomResolu    String?           @map("equipe_nom_resolu") @db.VarChar(100)
  resoluAt           DateTime?         @map("resolu_at")
  resoluManuellement Boolean           @default(false) @map("resolu_manuellement")
  createdAt          DateTime          @default(now()) @map("created_at")
  edition            InscEdition       @relation(fields: [editionId], references: [id])

  @@unique([numMatch, cote])
  @@map("planning_match_slots")
}

// ===== MODULE FORMAT DE COMPETITION (graphe Phase/Groupe/Place/Lien) =====

enum FormatLienEtat {
  NON_DEFINI
  ELIMINE
  LIE

  @@map("format_lien_etat")
}

enum FormatPlaceOrigine {
  ALIAS
  LIEE

  @@map("format_place_origine")
}

enum FormatGroupeFormule {
  CHAMPIONNAT
  RONDE_SUISSE

  @@map("format_groupe_formule")
}

model FormatPhase {
  id        Int               @id @default(autoincrement())
  editionId Int               @map("edition_id")
  nom       String            @db.VarChar(60)
  ordre     Int
  edition   InscEdition       @relation(fields: [editionId], references: [id])
  groupes   FormatGroupe[]
  jours     FormatPhaseJour[]

  @@unique([editionId, ordre])
  @@map("format_phases")
}

model FormatPhaseJour {
  id            Int             @id @default(autoincrement())
  phaseId       Int             @map("phase_id")
  editionJourId Int             @map("edition_jour_id")
  phase         FormatPhase     @relation(fields: [phaseId], references: [id])
  editionJour   InscEditionJour @relation(fields: [editionJourId], references: [id])

  @@unique([phaseId, editionJourId])
  @@map("format_phase_jours")
}

model FormatGroupe {
  id            Int                 @id @default(autoincrement())
  phaseId       Int                 @map("phase_id")
  nom           String              @db.VarChar(60)
  ordre         Int
  formule       FormatGroupeFormule @default(CHAMPIONNAT) @map("formule")
  phase         FormatPhase         @relation(fields: [phaseId], references: [id])
  places        FormatPlace[]
  liensSortants FormatLien[]        @relation("LienSource")

  @@unique([phaseId, ordre])
  @@map("format_groupes")
}

model FormatPlace {
  id          Int                @id @default(autoincrement())
  groupeId    Int                @map("groupe_id")
  position    Int
  origine     FormatPlaceOrigine
  aliasLabel  String?            @map("alias_label") @db.VarChar(60)
  lienEntrant FormatLien?        @relation("LienCiblePlace")
  groupe      FormatGroupe       @relation(fields: [groupeId], references: [id])

  @@unique([groupeId, position])
  @@map("format_places")
}

model FormatLien {
  id             Int            @id @default(autoincrement())
  groupeSourceId Int            @map("groupe_source_id")
  rangSource     Int            @map("rang_source")
  etat           FormatLienEtat @default(NON_DEFINI)
  groupeCibleId  Int?           @map("groupe_cible_id")
  placeCibleId   Int?           @unique @map("place_cible_id")
  groupeSource   FormatGroupe   @relation("LienSource", fields: [groupeSourceId], references: [id])
  placeCible     FormatPlace?   @relation("LienCiblePlace", fields: [placeCibleId], references: [id])

  @@unique([groupeSourceId, rangSource])
  @@map("format_liens")
}

model FormatMeta {
  editionId           Int                        @id @map("edition_id")
  genereDepuisPreset  PlanningFormatPhaseFinale?  @map("genere_depuis_preset")
  modifieManuellement Boolean                    @default(false) @map("modifie_manuellement")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  edition             InscEdition                @relation(fields: [editionId], references: [id])

  @@map("format_meta")
}

model PresentationArticle {
  id            Int      @id @default(autoincrement())
  groupe        String   @db.VarChar(100)
  groupeEn      String   @map("groupe_en") @db.VarChar(100)
  surtitre      String   @default("") @db.VarChar(100)
  surtitreEn    String   @default("") @map("surtitre_en") @db.VarChar(100)
  titre         String   @db.VarChar(150)
  titreEn       String   @map("titre_en") @db.VarChar(150)
  description   String   @db.Text
  descriptionEn String   @map("description_en") @db.Text
  faits         String?  @db.Text
  faitsEn       String?  @map("faits_en") @db.Text
  titreAccroche String   @default("") @map("titre_accroche") @db.VarChar(100)
  titreAccrocheEn String @default("") @map("titre_accroche_en") @db.VarChar(100)
  descriptionCourte   String @default("") @map("description_courte") @db.VarChar(320)
  descriptionCourteEn String @default("") @map("description_courte_en") @db.VarChar(320)
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  lienUrl       String?  @map("lien_url") @db.VarChar(500)
  lieu          String?  @db.VarChar(255)
  mapsQuery     String?  @map("maps_query") @db.VarChar(255)
  ordre         Int      @default(0)
  groupeOrdre   Int      @default(0) @map("groupe_ordre")
  groupeDureeMs Int      @default(5000) @map("groupe_duree_ms")
  groupeImageUrl String? @map("groupe_image_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("presentation_articles")
}
